# Private Role Passcodes (hashed with salted SHA-256 at build time by vite.config.js)
# Because these do NOT start with VITE_, plaintext passcodes are NEVER exposed in the browser bundle.
# Never commit your real .env file to GitHub.
JUDGE_PASSCODE=
DEV_PASSCODE=

# Optional: Pre-computed SHA-256 hashes (only needed if you prefer setting hashes directly in CI)
# VITE_JUDGE_PASS_HASH=
# VITE_DEV_PASS_HASH=

# Formspree Form ID for Guest Access
# Create a free form at https://formspree.io and paste your Form ID here (e.g. mljbnkdg)
VITE_FORMSPREE_FORM_ID=

# Application URL
# Local testing: http://localhost:5173
# Production deploy: https://www.wareprise.com/counselor/
VITE_APP_URL=http://localhost:5173

# Optional Google Gemini API Key for Layer 1 AI responses
# If unset, the app falls back to Layer 2 (Free AI) and Layer 3 (Offline Local Engine)
VITE_GEMINI_API_KEY=
